/* EVALUATION PROCEDURE DECLARATION */

void updatemodel (int phase) {

/* CONSTANT DECLARATIONS */

/* global this
 */

/* STRUCTURE TYPE DECLARATIONS */


    /* UPDATE FUNCTION VALUES */

    Desktop2type* Desktop2pointer;
    Desktop2pointer = &(this->Desktop2);
    Desktop2pointer->rabbits = Desktop2pointer->rabbits+stage_incr(Desktop2pointer->rabbits, &(Desktop2pointer->rabbits_extras), 1, Desktop2pointer->rabbit_repro+ -Desktop2pointer->predation, 0, 0, 0, 105);
    Desktop2pointer->foxes = Desktop2pointer->foxes+stage_incr(Desktop2pointer->foxes, &(Desktop2pointer->foxes_extras), 1, Desktop2pointer->fox_repro+ -Desktop2pointer->fox_mortality, 0, 0, 0, 107);

}; /* end(procedure,updatemodel) */

/* PROCEDURES FOR SEPARATE SUBMODELS */
/* EVALUATION PROCEDURE DECLARATION */

void evalmodel (int phase) {

/* CONSTANT DECLARATIONS */

/* global this
 */

/* STRUCTURE TYPE DECLARATIONS */


    /* UPDATE FUNCTION VALUES */

    if (1>=phase) {
        Desktop2type* Desktop2pointer;
        Desktop2pointer = &(this->Desktop2);
        Desktop2pointer->rabbit_birth_rate = min(1,max( 0.25, 0.5));
        collect(&(Desktop2pointer->rabbit_birth_rate), 113, 0);
        Desktop2pointer->attack_rate = min( 0.02,max( 0.005, 0.01));
        collect(&(Desktop2pointer->attack_rate), 114, 0);
        Desktop2pointer->conversion_rate = min( 0.02,max( 0.005, 0.01));
        collect(&(Desktop2pointer->conversion_rate), 115, 0);
        Desktop2pointer->fox_death_rate = min( 0.4,max( 0.1, 0.2));
        collect(&(Desktop2pointer->fox_death_rate), 116, 0);
        Desktop2pointer->initial_rabbits = min(10000,max(2500,5000));
        collect(&(Desktop2pointer->initial_rabbits), 117, 0);
        Desktop2pointer->initial_foxes = min(90,max( 22.5,45));
        collect(&(Desktop2pointer->initial_foxes), 118, 0);
        if (0>=phase) {
            Desktop2pointer = &(this->Desktop2);
            Desktop2pointer->rabbits = Desktop2pointer->initial_rabbits;
            Desktop2pointer->foxes = Desktop2pointer->initial_foxes;
        }; /* end(cond,0>=phase) */
    }; /* end(cond,1>=phase) */
    Desktop2type* Desktop2pointer;
    Desktop2pointer = &(this->Desktop2);
    Desktop2pointer->fox_mortality = Desktop2pointer->fox_death_rate*Desktop2pointer->foxes;
    Desktop2pointer->eaten_per_fox = Desktop2pointer->attack_rate*Desktop2pointer->rabbits;
    Desktop2pointer->predation = Desktop2pointer->eaten_per_fox*Desktop2pointer->foxes;
    Desktop2pointer->rfox = Desktop2pointer->conversion_rate*Desktop2pointer->eaten_per_fox;
    Desktop2pointer->fox_repro = Desktop2pointer->rfox*Desktop2pointer->foxes;
    Desktop2pointer->rabbit_repro = Desktop2pointer->rabbit_birth_rate*Desktop2pointer->rabbits;

}; /* end(procedure,evalmodel) */

