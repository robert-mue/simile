void evalmodel (int phase) {

/* CONSTANT DECLARATIONS */

/* global this
 */

/* STRUCTURE TYPE DECLARATIONS */


    /* UPDATE FUNCTION VALUES */

    if (0>=phase) {
        if (-2>=phase) {
            Desktop2type* Desktop2pointer;
            Desktop2pointer = &(this->Desktop2);
            Desktop2pointer->r =  0.06;
            Desktop2pointer->K = 1000;
            Desktop2pointer->a = 5;
            Desktop2pointer->g =  0.2;
            Desktop2pointer->m =  0.9;
            Desktop2pointer->L = 50;
        }; /* end(cond,-2>=phase) */
        Desktop2type* Desktop2pointer;
        Desktop2pointer = &(this->Desktop2);
        Desktop2pointer->x = 10;
        Desktop2pointer->y =  0.02;
    }; /* end(cond,0>=phase) */
    Desktop2type* Desktop2pointer;
    Desktop2pointer = &(this->Desktop2);
    Desktop2pointer->repro1 = Desktop2pointer->r*Desktop2pointer->x*(1-(double)(Desktop2pointer->x)/Desktop2pointer->K)-(double)(Desktop2pointer->a*Desktop2pointer->x*Desktop2pointer->x)/(Desktop2pointer->x*Desktop2pointer->x+Desktop2pointer->L)*Desktop2pointer->y;
    Desktop2pointer->repro2 = Desktop2pointer->g*Desktop2pointer->y*((double)(Desktop2pointer->a*Desktop2pointer->x*Desktop2pointer->x)/(Desktop2pointer->x*Desktop2pointer->x+Desktop2pointer->L))-Desktop2pointer->m*Desktop2pointer->y;

}; /* end(procedure,evalmodel) */

