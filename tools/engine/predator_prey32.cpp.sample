    Desktop2pointer->y = Desktop2pointer->y+stage_incr(Desktop2pointer->y, &(Desktop2pointer->y_extras), 1, Desktop2pointer->repro2, 0, 0, 0, 107);

}; /* end(procedure,updatemodel) */

